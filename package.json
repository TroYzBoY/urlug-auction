{
  "name": "urlug",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:db",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "db:migrate": "node --env-file-if-exists=.env.local --experimental-strip-types db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --experimental-strip-types db/seed.ts",
    "db:make-admin": "node --env-file-if-exists=.env.local --experimental-strip-types db/make-admin.ts",
    "db:psql": "docker compose exec db psql -U urlug -d urlug",
    "db:logs": "docker compose logs -f db"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^13.1.0",
    "lenis": "^1.3.26",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
