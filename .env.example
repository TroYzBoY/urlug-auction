# ─────────────────────────────────────────────────────────────────────────────
# MAISON — environment
#
# Copy to `.env.local` (which .gitignore already excludes) and fill in.
# Everything without a default is required; the server refuses to boot without
# it rather than failing later with `undefined` in a connection string.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────────────────────
# Postgres 14+. Needs LISTEN/NOTIFY and advisory locks, so a connection pooler
# in transaction mode (PgBouncer's default) will NOT work for the listener
# connection — use session mode, or point DATABASE_URL at the server directly.
DATABASE_URL=postgres://maison:maison@localhost:5432/maison

# Connections in the pool. The LISTEN connection and the ticker's advisory-lock
# connection are held OUTSIDE this, so the real ceiling is DATABASE_POOL_MAX+2.
DATABASE_POOL_MAX=10


# ── Sessions ─────────────────────────────────────────────────────────────────
# Long enough to outlast a 2h45m sale plus a night's sleep.
SESSION_TTL_DAYS=30


# ── SMS (required in production) ─────────────────────────────────────────────
# Receives POST {to, from, text}. Adjust the body in src/lib/sms.ts to whatever
# the chosen Mongolian gateway expects.
#
# Left empty in development, where verification codes are printed to the server
# log instead. Empty in production is a BOOT FAILURE, on purpose: a sign-up flow
# that silently drops its codes locks every new bidder out, and it looks fine
# from the outside.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=MAISON


# ── Rules version ────────────────────────────────────────────────────────────
# Recorded against each user's terms acceptance. Bump it whenever the rules
# change materially, so it is answerable which text a given bidder agreed to.
TERMS_VERSION=2026-08-21


# ── Demo time compression ────────────────────────────────────────────────────
# Divides ROUND durations; bid clocks are never scaled. At 60, one real minute
# maps to one second and the whole six-round arc plays in 2min45s.
#
# ⚠ MUST be 1 in production — src/lib/auction.ts throws at import if a
# production build sees anything else. At 60 a 2h45m sale would end in 2m45s.
#
# NEXT_PUBLIC_ because the client counts down against the same number; two
# copies would mean a countdown that disagrees with when the hammer falls.
NEXT_PUBLIC_ROUND_TIME_SCALE=1


# ── Public site URL ──────────────────────────────────────────────────────────
# Used by metadataBase, robots.txt and sitemap.xml, all of which emit absolute
# URLs. Wrong here means share cards render blank and the sitemap points at
# localhost — visible failures, but only after a link has been posted.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ── Payments (required to take money) ────────────────────────────────────────
# Left empty in development: the wallet redirects to a local confirm route that
# credits points without anybody paying, so the whole flow can be exercised.
# That route refuses to run when NODE_ENV=production, and createInvoice throws
# rather than handing out free points — see src/lib/payments.ts.
QPAY_API_URL=
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# The secret the provider signs its callbacks with. Without it the callback
# route rejects EVERYTHING, which is the correct default for an endpoint that
# credits points.
QPAY_CALLBACK_SECRET=


# ── Analytics (optional) ─────────────────────────────────────────────────────
# Cookie-free and self-hostable only — Plausible or Umami. That is a legal
# choice as much as a technical one: no cookie and no cross-site identifier
# means no consent banner and nothing to declare beyond what /privacy says.
#
# ⚠ The CSP in src/proxy.ts is 'self' only. Add the host to script-src and
# connect-src or the script is blocked. The failure is visible, not silent.
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=


# ── HSTS ─────────────────────────────────────────────────────────────────────
# OFF unless this is exactly "1". It is the one header with no undo: a browser
# that has seen it refuses plain HTTP to this domain and every subdomain for two
# years, whatever the server later says. Never set it on staging.
ENABLE_HSTS=


# ── Testing ──────────────────────────────────────────────────────────────────
# The database `npm run test:db` and the e2e suite are allowed to TRUNCATE.
# test/db.ts refuses anything whose name does not end in _test.
TEST_DATABASE_URL=postgres://maison:maison@localhost:5432/maison_test
